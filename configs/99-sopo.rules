# sopo 로봇암 시리얼 어댑터 udev 규칙
# 설치: sudo cp configs/99-sopo.rules /etc/udev/rules.d/ && sudo udevadm control --reload-rules && sudo udevadm trigger
#
# 효과: (1) 어댑터를 꽂을 때마다 자동으로 rw 권한 (chmod 필요 없음)
#       (2) 시리얼 번호별 고정 이름 /dev/sopo_* — ttyACM0/1이 뒤바뀌어도 안전
#
# 새 어댑터(리더 암 등)를 추가하려면: udevadm info -a -n /dev/ttyACMx | grep serial 로 번호를 읽어 줄 추가.

# 팔로워 암 어댑터: WCH CH343 (1a86:55d3), serial 5ABA005251
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", ATTRS{serial}=="5ABA005251", MODE="0666", GROUP="dialout", SYMLINK+="sopo_follower"

# 같은 종류의 다른 어댑터(시리얼 미지정)도 최소한 권한은 열어준다
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", MODE="0666", GROUP="dialout"
